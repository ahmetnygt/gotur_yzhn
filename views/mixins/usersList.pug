each u in users
    - const isDeleted = Boolean(u.isDeleted)
    - const btnClass = isDeleted ? 'btn-outline-secondary' : 'btn-outline-primary'
    .btn-group.w-100
        button.user-button.d-flex.btn.col-11(type="button" class=btnClass data-id=u.id data-username=u.username data-name=u.name data-deleted=isDeleted)
            .col-4
                p.text-center.m-0 #{u.name}#{isDeleted ? ' (Silinmiş)' : ''}
            .col-4
                p.text-center.m-0 #{u.branchStr}
            .col-4
                p.text-center.m-0 #{u.phoneNumber}
        if isDeleted
            .col-1
        else
            button.btn.btn-outline-danger.user-delete.col-1(type="button" data-id=u.id data-name=u.name aria-label=`${u.name} kullanıcısını sil`)
                i.fa-solid.fa-trash
